{
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 120,
	"singleQuote": true,
	"semi": false,
	"trailingComma": "all",
	"bracketSpacing": true,
	"arrowParens": "avoid",
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }]
}
