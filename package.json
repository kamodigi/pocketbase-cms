{
	"name": "pocketbase-cms",
	"version": "0.0.0",
	"description": "An admin UI for PocketBase, generated at runtime from your collection schema.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kamodigi/pocketbase-cms.git"
	},
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.9.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#paraglide/*": "./src/paraglide/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@playwright/test": "^1.65.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.9",
		"@types/node": "^22.20.5",
		"ajv": "^8.20.0",
		"bits-ui": "^2.20.0",
		"clsx": "^2.1.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.13.0",
		"eslint-plugin-svelte": "^3.24.1",
		"eslint-plugin-unicorn": "^79.0.0",
		"fflate": "^0.8.3",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"pocketbase": "^0.28.2",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	}
}
