{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true
	},
	"include": [
		"src",
		"hooks/**/*.ts",
		"tests",
		"tools",
		"playwright.config.ts",
		"vite.config.ts",
		"vitest.integration.config.ts",
		"vitest-setup.ts"
	],
	// Server middleware generated by Paraglide; this SPA has no server and does not import it.
	"exclude": ["src/paraglide/server.js"]
}
