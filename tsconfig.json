{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true
	},
	"include": [
		"src",
		"hooks/**/*.ts",
		"tests",
		"tools",
		"playwright.config.ts",
		"vite.config.ts",
		"vitest.integration.config.ts",
		"vitest-setup.ts"
	],
	// Server middleware generated by Paraglide; this SPA has no server and does not import it.
	// Test hooks run in PocketBase's JS runtime, whose globals TypeScript does not know.
	"exclude": ["src/paraglide/server.js", "tests/integration/fixtures"]
}
